# LazyCareer — repo-wide ignores
#
# TODO: stack-specific ignores (node_modules/, dist/, __pycache__/, .venv/, etc.)
# get added once the tech stack is decided.
# See docs/open-questions.md — "Tech stack per module".

# --- Secrets & local config ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS cruft ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Editors & IDEs ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
*.swo
*~

# --- Local agent / tooling state (shared agent context in .agents/ IS tracked) ---
.claude/settings.local.json
.codegraph/

# --- Build & temp output ---
tmp/
temp/
coverage/
